function getAllResearch() {
  if (!state.researchHistory) return 'No research history.';
  return state.researchHistory.sort((a,b) => a.week - b.week || a.timestamp - b.timestamp).map(r =>
    `Week ${r.week} [${new Date(r.timestamp).toLocaleString()}]\n${r.content}`
  ).join('\n\n');
