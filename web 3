function exportResearchTxt() {
  const content = getAllResearch();
  download(content, 'all_research_history.txt', 'text/plain');
}

function exportResearchDoc() {
  const content = getAllResearch();
  const html = `<html><head><meta charset="utf-8"></head><body><pre style="font-family:inherit;white-space:pre-wrap;">${esc(content)}</pre></body></html>`;
  download(html, 'all_research_history.doc', 'application/msword');
}

function download(content, filename, mime) {
  const blob = new Blob([content], { type: mime + ';charset=utf-8' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = filename;
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

// ================================================================
// WORK AUTO-SAVE BINDING
// ================================================================
function bindWorkAutoSave() {
  const thesis = document.getElementById('thesis');
  const draft = document.getElementById('draft');
  if (thesis) {
    thesis.oninput = function() {
      clearTimeout(saveTimer);
      saveTimer = setTimeout(() => {
        state.writing[state.week] = { thesis: thesis.value, draft: draft ? draft.value : '' };
        save();
        let s = document.getElementById('saveStatus');
        if (s) { s.textContent = 'Saved'; setTimeout(() => { if (s) s.textContent = '' }, 1500); }
      }, 450);
    };
  }
  if (draft) {
    draft.oninput = function() {
      clearTimeout(saveTimer);
      saveTimer = setTimeout(() => {
        state.writing[state.week] = { thesis: thesis ? thesis.value : '', draft: draft.value };
        save();
        let s = document.getElementById('saveStatus');
        if (s) { s.textContent = 'Saved'; setTimeout(() => { if (s) s.textContent = '' }, 1500); }
      }, 450);
    };
  }
  ['under','surprise','disagree','changed','remain'].forEach(id => {
    const el = document.getElementById(id);
    if (el) {
      el.oninput = function() {
        clearTimeout(saveTimer);
        saveTimer = setTimeout(() => {
          let obj = { week: state.week };
          ['under','surprise','disagree','changed','remain'].forEach(k => {
            obj[k] = document.getElementById(k) ? document.getElementById(k).value : '';
          });
          state.reflections = state.reflections.filter(x => x.week != state.week);
          state.reflections.push(obj);
          save();
        }, 450);
      };
    }
  });
  const researchInput = document.getElementById('researchInput');
  if (researchInput) {
    researchInput.oninput = function() {
      clearTimeout(saveTimer);
      saveTimer = setTimeout(() => {
        const val = researchInput.value.trim();
        if (val) {
          if (!state.researchHistory) state.researchHistory = [];
          state.researchHistory.push({ week: state.week, content: val, timestamp: Date.now() });
          researchInput.value = '';
          save();
          render();
        }
      }, 700);
    };
  }
}

