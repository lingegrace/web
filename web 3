// ================================================================
// AUTO-FILL
// ================================================================
function tryFillBlock(block) {
  let pending = state.tasks.filter(t => t.week == block.week && !t.done && t.day == null).sort((a,b) => b.priority - a.priority);
  for (let task of pending) {
    let dur = toMin(block.end) - toMin(block.start);
    if (dur >= task.mins) { task.day = block.day; task.start = block.start; block.start = toTime(toMin(block.start) + task.mins); return task.title }
  }
  return null;
}

function autoFillWeek() {
  let changed = true, placed = [];
  while (changed) {
    changed = false;
    let blocks = state.available.filter(a => a.week == state.week).sort((a,b) => a.day - b.day || toMin(a.start) - toMin(b.start));
    for (let block of blocks) { let title = tryFillBlock(block); if (title) { placed.push(title); changed = true; break } }
  }
  state.available = state.available.filter(a => toMin(a.end) - toMin(a.start) > 0);
  let stillPending = state.tasks.filter(t => t.week == state.week && !t.done && t.day == null);
  replanNotice = { placed, pendingTitles: stillPending.map(t => t.title) };
  save(); render();
}

function dismissNotice() { replanNotice = null; render(); }

function replanBanner() {
  if (!replanNotice) return "";
  let lines = [];
  if (replanNotice.placed.length) lines.push(`Placed ${replanNotice.placed.length}: ${esc(replanNotice.placed.join(", "))}`);
  if (replanNotice.pendingTitles.length) lines.push(`⚠ Still unscheduled: ${esc(replanNotice.pendingTitles.join(", "))} — add more available time to fit ${replanNotice.pendingTitles.length>1?"them":"it"}.`);
  if (!replanNotice.placed.length && !replanNotice.pendingTitles.length) lines.push("Nothing to place — everything is scheduled or done.");
  return `<div class="notice" style="margin-bottom:12px">${lines.map(l=>`<div>${l}</div>`).join("")}<button style="margin-top:8px" onclick="dismissNotice()">Dismiss</button></div>`;
}
