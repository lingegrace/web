// ================================================================
// AI GENERATION (保留原版，但需注意 API 端点可能需要真实 key)
// ================================================================
async function generateResearch() {
  let input = document.getElementById("thesis") ? document.getElementById("thesis").value.trim() : "";
  if (!input) { alert("Write a thought in the thesis field first."); return }
  let box = document.getElementById("aiResult");
  if (!box) return;
  box.innerHTML = '<div class="muted">Thinking…</div>';
  let w = weekData();
  const prompt = `You are the research module inside the user's personal "Intellectual OS", a study system built around this week's question: "${w.q}" (lens: ${w.lens}).
The user just wrote this reflection or thought:
"""${input}"""
Respond ONLY with a valid JSON object, no markdown code fences, no preamble, matching exactly this shape:
{"relatedResearch":[{"title":"...","note":"..."}],"counterarguments":["..."],"empiricalExamples":["..."],"industrySignals":["..."],"possibleTheses":["..."]}
Give 3-5 items in relatedResearch, 2-4 in counterarguments and empiricalExamples, 2-3 in industrySignals, 3-4 in possibleTheses. possibleTheses must be phrased as open options, not a recommendation — never tell the user which one to pick.`;
  try {
    // 注意：实际使用需要替换为您的 API key，此处为演示保留原样
    const response = await fetch("https://api.anthropic.com/v1/messages", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ model: "claude-sonnet-4-6", max_tokens: 1000, messages: [{ role: "user", content: prompt }] })
    });
    const data = await response.json();
    let text = (data.content || []).map(c => c.text || "").join("\n").replace(/```json|```/g, "").trim();
    const parsed = JSON.parse(text);
    lastAIResult = { input, result: parsed };
    box.innerHTML = aiResultBlock(parsed) + `<div class="actions" style="margin-top:10px"><button class="primary" onclick="saveAI()">Save to this week</button></div>`;
  } catch (e) {
    console.error(e);
    box.innerHTML = '<div class="notice danger">Could not generate research this time — try again in a moment.</div>';
  }
}

function saveAI() {
  if (!lastAIResult) return;
  state.airesearch.push({ id: "ai" + Date.now(), week: state.week, input: lastAIResult.input, result: lastAIResult.result, ts: Date.now() });
  lastAIResult = null;
  save(); render();
}

